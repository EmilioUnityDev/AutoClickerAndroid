<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: la app usa la barra de título clásica; sin esto el
         contenido se dibuja debajo de la barra de estado y del título. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#5848C8</item>
        <item name="colorPrimaryVariant">#3A2E8F</item>
        <item name="colorSecondary">#78C828</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
